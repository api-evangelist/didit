                "description": "Application UUID."
              },
              {
                "name": "case_uuid",
                "value": "",
                "type": "path",
                "description": "Case UUID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Act on the case's subject without leaving the case: set_status changes the user/business status, add_tags applies applicant tags, add_note posts an internal case note, and add_to_blocklist adds the subject's latest document and face to the blocklist. Logs an ENTITY_ACTION event."
        },
