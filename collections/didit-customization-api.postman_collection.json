        {
          "id": "47abe227-323c-40c1-82da-aad96ad303b2",
          "name": "Update branding customization",
          "request": {
            "name": "Update branding customization",
            "description": {
              "content": "Partial update of the application's white-label branding. Send `application/json` to change colors, fonts, radii and UI options, or `multipart/form-data` to upload logo images. Only the fields you include are changed. Custom domain and white-label email cannot be set through this endpoint — use the Business Console for those.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "customization",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image_square",
                  "type": "file",
                  "description": "Square logo (1:1 aspect ratio). Max **1 MB**. Allowed: `png`, `jpg`, `jpeg`, `webp`."
                },
                {
                  "key": "image_rectangular",
                  "type": "file",
                  "description": "Rectangular logo (2:1 aspect ratio). Max **1 MB**. Allowed: `png`, `jpg`, `jpeg`, `webp`."
                },
                {
                  "key": "image_favicon",
                  "type": "file",
                  "description": "Favicon image. Max **500 KB**."
                }
              ]
            }
          },
          "response": [
            {
              "id": "0a44e4fd-f760-48c6-8e95-fd9418399c4e",
              "name": "Branding updated. The FULL branding object is returned (all fields, not just the ones you changed).",
              "originalRequest": {
                "url": {
                  "path": [
                    "v3",
                    "customization",
                    ""
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "x-api-key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "PATCH",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "Rectangular logo (2:1 aspect ratio). Max **1 MB**. Allowed: `png`, `jpg`, `jpeg`, `webp`.",
                        "type": "text/plain"
                      },
                      "key": "image_rectangular",
                      "type": "file"
                    },
                    {
                      "description": {
                        "content": "Favicon image. Max **500 KB**.",
                        "type": "text/plain"
                      },
                      "key": "image_favicon",
                      "type": "file"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"color_primary\": \"#123456\",\n  \"color_secondary\": \"#9DA1A1\",\n  \"color_background\": \"#FFFFFF\",\n  \"color_panel\": \"#2567FF\",\n  \"color_panel_10\": \"#1A1A1A\",\n  \"color_on_panel_1\": \"#9DA1A1\",\n  \"color_on_panel_2\": \"#F4F4F6\",\n  \"color_on_background\": \"#000000\",\n  \"color_button_1\": \"#2567FF\",\n  \"color_button_2\": \"#F8F8F8\",\n  \"color_button_text_1\": \"#FFFFFF\",\n  \"color_button_text_2\": \"#000000\",\n  \"color_pill_text\": \"#111827\",\n  \"border_radius_panel\": 10,\n  \"border_radius_buttons\": 16,\n  \"font_family\": \"AR One Sans\",\n  \"font_weight\": \"400\",\n  \"font_url\": \"https://fonts.googleapis.com/css2?family=AR+One+Sans\",\n  \"logo_square\": null,\n  \"logo_rectangular\": \"https://cdn.didit.me/white_label/logo_rectangular/...\",\n  \"favicon\": null,\n  \"app_public_name\": \"Acme Verify\",\n  \"privacy_policy_url\": \"https://acme.com/privacy\",\n  \"skip_welcome_screen\": true,\n  \"disable_login_with_didit\": false,\n  \"hide_progress_bar\": false,\n  \"callback_seconds\": 3\n}",
