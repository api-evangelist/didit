{
  "opencollection": "1.0.0",
  "info": {
    "name": "Didit Verification Billing Case Blueprints API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Case Blueprints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List blueprints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset."
              }
            ]
          },
          "docs": "List case blueprints for the application."
        },
        {
          "info": {
            "name": "Create blueprint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a case blueprint: general settings (assignment, escalation, transfer, 4-eyes pairing) plus content_config, the six sections that drive the case page."
        },
        {
          "info": {
            "name": "Get blueprint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/:blueprint_uuid/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              },
              {
                "name": "blueprint_uuid",
                "value": "",
                "type": "path",
                "description": "Blueprint UUID."
              }
            ]
          },
          "docs": "Retrieve a blueprint, including its connected creation sources (AML config, transaction rules, workflow nodes) and which blueprints escalate to it."
        },
        {
          "info": {
            "name": "Update blueprint",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/:blueprint_uuid/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              },
              {
                "name": "blueprint_uuid",
                "value": "",
                "type": "path",
                "description": "Blueprint UUID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Partially update a blueprint's general settings or content_config."
        },
        {
          "info": {
            "name": "Delete blueprint",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/:blueprint_uuid/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              },
              {
                "name": "blueprint_uuid",
                "value": "",
                "type": "path",
                "description": "Blueprint UUID."
              }
            ]
          },
          "docs": "Soft-delete a blueprint. Deletion always succeeds and does not touch the blueprint's cases: existing cases keep their blueprint reference and its settings continue to apply to them. A deleted blueprint no longer appears in blueprint lists and can no longer be chosen as a transfer target; if a maker blueprint is deleted while a resolution is pending 4-eyes approval, a rejected resolution leaves the case on the checker blueprint."
        },
        {
          "info": {
            "name": "List blueprint presets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/presets/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              }
            ]
          },
          "docs": "List the four built-in presets (Screening hit, AML investigation, Suspicious activity, KYC review) with their content_config and whether each is already installed on this application."
        },
        {
          "info": {
            "name": "Install blueprint presets",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://verification.didit.me/v3/organization/:organization_id/application/:application_id/cases/blueprints/presets/install/",
            "params": [
              {
                "name": "organization_id",
                "value": "",
                "type": "path",
                "description": "Organization UUID."
              },
              {
                "name": "application_id",
                "value": "",
                "type": "path",
                "description": "Application UUID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Copy one or more presets into the application as editable blueprints. Idempotent per preset_key; omit preset_keys to install every preset not yet installed."
        }
      ]
    }
  ],
  "bundled": true
}